---
import Page from "@/layouts/Page.astro";
import ViewCount from "@/components/ViewCount.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Page
  title="Blog | Ebenezer Isaac"
  description="Writing on software engineering, AEM, IoT, and the craft of building things."
  active="blog"
>
  <section class="section">
    <div class="container mx-auto px-4">
      <div class="section-title">
        <h2>Blog</h2>
        <p>Thoughts, learnings, and technical deep-dives</p>
      </div>

      {posts.length === 0 ? (
        <div class="text-center py-16">
          <i class="bi bi-pencil-square text-4xl text-muted/30"></i>
          <p class="text-muted mt-4">Posts coming soon.</p>
        </div>
      ) : (
        <div class="max-w-3xl mx-auto space-y-5">
          {posts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString("en-GB", {
              year: "numeric",
              month: "long",
              day: "numeric",
            });
            const wordCount = post.body ? post.body.split(/\s+/).length : 0;
            const readingTime = Math.max(1, Math.ceil(wordCount / 200));

            return (
              <a
                href={`/blog/${post.id}/`}
                class="block bg-white rounded-xl p-6 hover:shadow-md transition-shadow group"
              >
                <div class="flex flex-wrap items-center gap-3 text-xs text-muted mb-2">
                  <span class="flex items-center gap-1">
                    <i class="bi bi-calendar3"></i> {formattedDate}
                  </span>
                  <span class="flex items-center gap-1">
                    <i class="bi bi-clock"></i> {readingTime} min read
                  </span>
                  <ViewCount url={`/blog/${post.id}/`} />
                </div>
                <h3 class="text-lg font-bold text-heading group-hover:text-primary transition-colors mb-1">
                  {post.data.title}
                </h3>
                <p class="text-sm text-muted line-clamp-2">{post.data.excerpt}</p>
                {post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-1.5 mt-3">
                    {post.data.tags.map((tag) => (
                      <span class="px-2 py-0.5 rounded-full text-xs bg-primary/10 text-primary font-medium">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            );
          })}
        </div>
      )}
    </div>
  </section>
</Page>
