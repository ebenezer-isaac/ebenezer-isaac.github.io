---
interface NavItem {
  href: string;
  icon: string;
  label: string;
}

interface Props {
  active?: string;
}

const { active } = Astro.props;

const navItems: NavItem[] = [
  { href: "/#hero", icon: "bi-house", label: "Home" },
  { href: "/#about", icon: "bi-person", label: "About" },
  { href: "/#experience", icon: "bi-briefcase", label: "Experience" },
  { href: "/#skills", icon: "bi-hdd-stack", label: "Skills" },
  { href: "/#projects", icon: "bi-code-slash", label: "Projects" },
  { href: "/blog/", icon: "bi-pencil-square", label: "Blog" },
  { href: "/#contact", icon: "bi-envelope", label: "Contact" },
];
---

<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
/>

<!-- Mobile toggle -->
<button
  id="nav-toggle"
  class="fixed top-5 left-5 z-50 xl:hidden w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center shadow-lg cursor-pointer"
  aria-label="Toggle navigation"
>
  <i class="bi bi-list text-xl"></i>
</button>

<!-- Sidebar -->
<header
  id="header"
  class="fixed top-0 left-0 bottom-0 w-72 xl:w-[300px] bg-white shadow-lg z-40
         -translate-x-full xl:translate-x-0 transition-transform duration-300"
>
  <nav class="h-full flex flex-col justify-center px-8">
    <ul class="space-y-1">
      {navItems.map((item) => {
        const isActive =
          active === item.label.toLowerCase() ||
          (!active && item.label === "Home");
        return (
          <li>
            <a
              href={item.href}
              class:list={[
                "flex items-center gap-3 py-2.5 px-3 rounded-lg text-sm font-medium transition-all duration-200",
                isActive
                  ? "bg-primary/10 text-primary"
                  : "text-heading hover:text-primary hover:bg-gray-50",
              ]}
              data-nav-link
            >
              <i class={`bi ${item.icon} text-lg`} />
              <span>{item.label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>

<!-- Overlay for mobile -->
<div
  id="nav-overlay"
  class="fixed inset-0 bg-black/50 z-30 hidden xl:hidden"
></div>

<script>
  function initNav() {
    const toggle = document.getElementById("nav-toggle");
    const header = document.getElementById("header");
    const overlay = document.getElementById("nav-overlay");

    if (!toggle || !header || !overlay) return;

    function openNav() {
      header!.classList.remove("-translate-x-full");
      overlay!.classList.remove("hidden");
    }

    function closeNav() {
      header!.classList.add("-translate-x-full");
      overlay!.classList.add("hidden");
    }

    toggle.addEventListener("click", () => {
      const isOpen = !header.classList.contains("-translate-x-full");
      isOpen ? closeNav() : openNav();
    });

    overlay.addEventListener("click", closeNav);

    // Close on nav link click (mobile)
    header.querySelectorAll("a[data-nav-link]").forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth < 1280) closeNav();
      });
    });

    // Scrollspy for homepage
    const sections = document.querySelectorAll("section[id]");
    const navLinks = header.querySelectorAll("a[data-nav-link]");

    if (sections.length > 0) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              navLinks.forEach((link) => {
                const href = link.getAttribute("href") || "";
                const isMatch = href === `/#${id}` || href === `#${id}`;
                link.classList.toggle("bg-primary/10", isMatch);
                link.classList.toggle("text-primary", isMatch);
                link.classList.toggle("text-heading", !isMatch);
              });
            }
          });
        },
        { rootMargin: "-20% 0px -70% 0px" }
      );

      sections.forEach((section) => observer.observe(section));
    }
  }

  initNav();
  document.addEventListener("astro:after-swap", initNav);
</script>
