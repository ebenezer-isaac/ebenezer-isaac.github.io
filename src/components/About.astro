---
import resume from "@/data/resume";

const { basics, education, languages } = resume;
const latestEdu = education[0];

const facts = [
  { icon: "bi-mortarboard", label: "Degree", value: `${latestEdu?.studyType} ${latestEdu?.area?.split(" ").slice(0, 3).join(" ")}` },
  { icon: "bi-geo-alt", label: "Location", value: `${basics.location.city}, ${basics.location.countryCode}` },
  { icon: "bi-envelope", label: "Email", value: basics.email, href: `mailto:${basics.email}` },
  { icon: "bi-telephone", label: "Phone", value: basics.phone, href: `tel:${basics.phone.replace(/\s/g, "")}` },
  { icon: "bi-translate", label: "Languages", value: languages.map((l) => l.language).join(", ") },
];
---

<section id="about" class="section bg-white">
  <div class="container mx-auto px-4">
    <div class="section-title">
      <h2>About</h2>
      <p>
        Fascinated by electronics and computers, I started tinkering with wires and bytes from an early age.
      </p>
    </div>

    <div class="grid md:grid-cols-[280px_1fr] gap-8 items-start max-w-4xl mx-auto">
      <!-- Profile image -->
      <div class="flex justify-center">
        <img
          src="/profile-img.jpg"
          alt={basics.name}
          class="rounded-2xl shadow-lg w-64 md:w-full object-cover"
          loading="lazy"
        />
      </div>

      <!-- Info -->
      <div>
        <h3 class="text-xl font-bold font-heading text-heading mb-2">
          {basics.label.split(" ").slice(0, 4).join(" ")}
        </h3>
        <p class="text-muted text-sm leading-relaxed mb-4">
          {basics.summary}
        </p>

        <div class="grid sm:grid-cols-2 gap-3">
          {facts.map((fact) => (
            <div class="flex items-start gap-2.5">
              <i class={`bi ${fact.icon} text-primary mt-0.5`} />
              <div>
                <span class="text-xs font-semibold text-heading uppercase tracking-wide">
                  {fact.label}
                </span>
                {fact.href ? (
                  <a href={fact.href} class="block text-sm text-muted hover:text-primary transition-colors">
                    {fact.value}
                  </a>
                ) : (
                  <p class="text-sm text-muted">{fact.value}</p>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
