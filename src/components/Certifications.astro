---
import resume from "@/data/resume";

const { certificates } = resume;

const issuerColors: Record<string, string> = {
  AWS: "bg-amber-50 text-amber-700 border-amber-200",
  Adobe: "bg-red-50 text-red-700 border-red-200",
  SAP: "bg-blue-50 text-blue-700 border-blue-200",
};
---

<section id="certifications" class="section bg-bg">
  <div class="container mx-auto px-4">
    <div class="section-title">
      <h2>Certifications</h2>
    </div>

    <div class="grid sm:grid-cols-2 gap-4 max-w-3xl mx-auto">
      {certificates.map((cert) => {
        const colors = issuerColors[cert.issuer] ?? "bg-gray-50 text-gray-700 border-gray-200";
        return (
          <div class={`rounded-xl p-4 border ${colors} flex items-start gap-3`}>
            <i class="bi bi-patch-check-fill text-lg mt-0.5" />
            <div>
              <h4 class="text-sm font-bold leading-snug">{cert.name}</h4>
              <p class="text-xs mt-0.5 opacity-70">{cert.issuer}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
